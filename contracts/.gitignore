# Compiler files
cache/
out/

# Vendored Foundry dependencies (forge-std, openzeppelin-contracts).
# These are declared in .gitmodules and must not be committed as ordinary
# files -- that would add thousands of third-party sources to this repo.
# Restore them with:
#   git submodule update --init --recursive
#   (or `forge install`)
lib/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example
